# Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gfb_growth_os?schema=public"

# Redis (App & BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_ACCESS_SECRET="gfb_super_secret_access_token_min_32_chars_long_key"
JWT_REFRESH_SECRET="gfb_super_secret_refresh_token_min_32_chars_long_key"
COOKIE_SECRET="gfb_cookie_secret_string"

# WhatsApp Provider (Evolution API v2)
EVOLUTION_API_URL="https://evolution.gfbdigital.com.br"
EVOLUTION_API_KEY="your_evolution_master_api_key"

# Meta Graph API
META_GRAPH_API_VERSION="v20.0"

# Media & Storage
STORAGE_LOCAL_PATH="./data/uploads"
MEDIA_SERVICE_URL="http://localhost:8000"
