# ==============================================================================
# GFB Growth OS - Environment Variables Example (.env.example)
# ==============================================================================

# Application Ports & Environment
PORT=3001
NODE_ENV=production
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
POSTGRES_DB=gfb_growth_os
POSTGRES_USER=gfb_user
POSTGRES_PASSWORD=gfb_secure_pass_2026
DATABASE_URL=postgresql://gfb_user:gfb_secure_pass_2026@localhost:5432/gfb_growth_os?schema=public

# Redis & BullMQ Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=gfb_redis_secure_pass

# Security & Secrets (min 32 chars)
JWT_ACCESS_SECRET=gfb_master_jwt_secret_key_32_bytes_long
JWT_REFRESH_SECRET=gfb_master_jwt_refresh_secret_32_bytes
COOKIE_SECRET=gfb_cookie_secret_16_bytes_long

# WhatsApp Engine (Evolution API or Native)
EVOLUTION_API_URL=https://wpp.gfbdigital.com.br
EVOLUTION_API_KEY=B6D711FCDE4D4FD59365441E0C3970CC

# Meta Graph API
META_GRAPH_API_VERSION=v20.0

# MinIO S3 Compatible Storage
MINIO_ROOT_USER=gfb_storage_admin
MINIO_ROOT_PASSWORD=gfb_minio_secret_key_2026

# Local Storage Fallback
STORAGE_LOCAL_PATH=./data/uploads
